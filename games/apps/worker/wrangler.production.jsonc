{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "portfolio-games-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "observability": { "enabled": true },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchDurableObject" },
      { "name": "LOBBY_HUB", "class_name": "LobbyHubDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDirectoryDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["LobbyHubDurableObject"] },
    { "tag": "v4", "deleted_classes": ["LobbyDirectoryDurableObject"] }
  ],
  "ratelimits": [
    { "name": "ROOMS_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://play.ake-em.com"
  }
}
