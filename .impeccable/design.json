  "narrative": {
    "northStar": "A readable personal engineering page",
    "overview": "A restrained, text-first portfolio for Akeem Adeyemi. Small headings, a narrow reading column, quiet blue links, and native vertical flow let visitors explore engineering work at their own pace. The surface follows system light or dark preference, with a manual theme switch.\n\nThe owner selected https://limistah.dev/ as visual inspiration and confirmed its vertical layout. This provenance applies to composition and visual character, not the reference owner’s identity, biography, credentials, content, or portrait. Professional content comes from four owner-supplied resumes and the previous portfolio, as recorded in CONTENT_SOURCES.md. No portrait or project screenshots are currently supplied.",
    "keyCharacteristics": [
      "A small owner heading and generous section spacing.",
      "A centered reading column with simple project rows and softly filled experience entries.",
      "Off-white and near-black surfaces with quiet blue links.",
      "Predictable anchors, visible keyboard focus, and native detail dialogs."
    ],
    "rules": [
      {
        "name": "The Quiet Accent Rule",
        "body": "Reserve blue for links, project detail triggers, and keyboard focus; experience containers remain neutral.",
        "section": "colors"
      },
      {
        "name": "The Small Name Rule",
        "body": "Keep the owner heading at the existing title scale; spacing and the introduction establish the hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "Use tonal fills and spacing for ordinary content; reserve raised depth for the dialog.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the narrow vertical reading flow and compact name heading.",
      "Do use muted text for metadata and blue for actionable project titles and links.",
      "Do retain visible keyboard focus and generous touch targets.",
      "Do follow system theme by default and honor an explicit manual choice.",
      "Do keep professional claims traceable to the owner's supplied material."
    ],
    "donts": [
      "Don’t introduce a large hero, decorative numbering, or a default screenshot card gallery.",
      "Don’t turn experience hover into a takeover; activation opens details.",
      "Don’t invent a portrait, work history, credentials, screenshots, or working URLs.",
      "Don’t import the reference owner’s identity or content."
    ]
  }
}
