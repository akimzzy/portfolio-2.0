      "css": ".ds-preview{font-family:var(--font-portfolio-sans),sans-serif;color:#292d25}.ds-muted{color:#686d63}.ds-focus:focus-visible{outline:2px solid #5277ae;outline-offset:4px}.ds-link{color:#355f9c;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;transition:color 150ms cubic-bezier(.4,0,.2,1),text-decoration-color 150ms cubic-bezier(.4,0,.2,1)}.ds-link:hover{color:#203f6d;text-decoration-color:currentColor}.ds-project{padding:16px 0;border-bottom:1px solid rgb(0 0 0 / .06)}.ds-project-title{display:inline-flex;min-height:44px;max-width:100%;align-items:center;gap:8px;text-align:left;font:500 16px/24px var(--font-portfolio-sans),sans-serif;border:0;border-radius:4px;background:transparent;padding:0;touch-action:manipulation}.ds-summary{margin:0;font-size:15px;line-height:28px}.ds-tags{margin:6px 0 0;font-size:12px;line-height:24px}:host-context(html[data-theme=\"dark\"]) .ds-preview{color:#edeee8}:host-context(html[data-theme=\"dark\"]) .ds-muted{color:#a4a89c}:host-context(html[data-theme=\"dark\"]) .ds-focus:focus-visible{outline-color:#a9bddf}:host-context(html[data-theme=\"dark\"]) .ds-link{color:#9aaed7}:host-context(html[data-theme=\"dark\"]) .ds-link:hover{color:#c5d3ee}:host-context(html[data-theme=\"dark\"]) .ds-project{border-color:rgb(255 255 255 / .07)}@media(prefers-color-scheme:dark){:host-context(html:not([data-theme=\"light\"])) .ds-preview{color:#edeee8}:host-context(html:not([data-theme=\"light\"])) .ds-muted{color:#a4a89c}:host-context(html:not([data-theme=\"light\"])) .ds-focus:focus-visible{outline-color:#a9bddf}:host-context(html:not([data-theme=\"light\"])) .ds-link{color:#9aaed7}:host-context(html:not([data-theme=\"light\"])) .ds-link:hover{color:#c5d3ee}:host-context(html:not([data-theme=\"light\"])) .ds-project{border-color:rgb(255 255 255 / .07)}}"
    },
    {
      "name": "Experience entry",
      "kind": "card",
      "refersTo": "experience-entry",
      "description": "A whole-row detail trigger with quiet tonal fill, using the confirmed Adventlabs role.",
      "html": "<button class=\"ds-preview ds-experience ds-focus\" type=\"button\" aria-label=\"View Adventlabs experience details\"><span class=\"ds-entry-head\"><span class=\"ds-entry-title\">Adventlabs</span><span class=\"ds-date ds-muted\">Feb 2026 – Aug 2026</span></span><span class=\"ds-subtitle ds-muted\">Full-stack developer · Remote</span><span class=\"ds-entry-summary ds-muted\">Built subscription and billing workflows for Buzthrive, a multi-tenant inventory management platform.</span></button>",
      "css": ".ds-preview{font-family:var(--font-portfolio-sans),sans-serif;color:#292d25}.ds-muted{color:#686d63}.ds-focus:focus-visible{outline:2px solid #5277ae;outline-offset:4px}.ds-link{color:#355f9c;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;transition:color 150ms cubic-bezier(.4,0,.2,1),text-decoration-color 150ms cubic-bezier(.4,0,.2,1)}.ds-link:hover{color:#203f6d;text-decoration-color:currentColor}.ds-experience{display:block;width:100%;padding:16px;text-align:left;border:0;border-radius:8px;background:rgb(0 0 0 / .025);touch-action:manipulation;transition:background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-experience:hover{background:rgb(0 0 0 / .05)}.ds-entry-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;column-gap:16px;row-gap:4px}.ds-entry-title{font-size:16px;font-weight:500;line-height:24px}.ds-date{font-size:12px;line-height:16px;font-variant-numeric:tabular-nums}.ds-subtitle{display:block;margin-top:4px;font-size:14px;line-height:20px}.ds-entry-summary{display:block;margin-top:12px;font-size:14px;line-height:24px}@media(min-width:40rem){.ds-experience{padding:20px}}:host-context(html[data-theme=\"dark\"]) .ds-preview{color:#edeee8}:host-context(html[data-theme=\"dark\"]) .ds-muted{color:#a4a89c}:host-context(html[data-theme=\"dark\"]) .ds-focus:focus-visible{outline-color:#a9bddf}:host-context(html[data-theme=\"dark\"]) .ds-link{color:#9aaed7}:host-context(html[data-theme=\"dark\"]) .ds-link:hover{color:#c5d3ee}:host-context(html[data-theme=\"dark\"]) .ds-experience{background:rgb(255 255 255 / .035)}:host-context(html[data-theme=\"dark\"]) .ds-experience:hover{background:rgb(255 255 255 / .065)}@media(prefers-color-scheme:dark){:host-context(html:not([data-theme=\"light\"])) .ds-preview{color:#edeee8}:host-context(html:not([data-theme=\"light\"])) .ds-muted{color:#a4a89c}:host-context(html:not([data-theme=\"light\"])) .ds-focus:focus-visible{outline-color:#a9bddf}:hos