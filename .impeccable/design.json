    {
      "name": "Detail dialog",
      "kind": "custom",
      "refersTo": "detail-dialog",
      "description": "Static open native-dialog preview. The live application uses showModal, focus restoration, Escape/backdrop dismissal, and scroll locking.",
      "html": "<dialog open class=\"ds-preview ds-dialog\" aria-labelledby=\"ds-dialog-title\"><div class=\"ds-dialog-head\"><div><h2 id=\"ds-dialog-title\">QuikCity</h2><p class=\"ds-dialog-sub ds-muted\">Founder & product lead</p></div><form method=\"dialog\"><button class=\"ds-close ds-focus\" aria-label=\"Close details\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><path d=\"m5 5 10 10M15 5 5 15\"/></svg></button></form></div><p class=\"ds-dialog-summary\">A WhatsApp-first platform for ordering food and requesting courier services, without downloading a separate app.</p><p class=\"ds-dialog-description ds-muted\">I conceived, designed, and built QuikCity independently from concept to production. The platform connects customers, vendors, riders, payments, and logistics in one commerce workflow.</p></dialog>",
      "css": ".ds-preview{font-family:var(--font-portfolio-sans),sans-serif;color:#292d25}.ds-muted{color:#686d63}.ds-focus:focus-visible{outline:2px solid #5277ae;outline-offset:4px}.ds-link{color:#355f9c;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;transition:color 150ms cubic-bezier(.4,0,.2,1),text-decoration-color 150ms cubic-bezier(.4,0,.2,1)}.ds-link:hover{color:#203f6d;text-decoration-color:currentColor}.ds-dialog{position:relative;margin:auto;max-height:85svh;width:calc(100% - 2rem);max-width:640px;overflow-y:auto;overscroll-behavior:contain;border:0;border-radius:12px;background:#f8f8f5;padding:24px;box-shadow:0 20px 25px -5px rgb(0 0 0 / .1),0 8px 10px -6px rgb(0 0 0 / .1)}.ds-dialog::backdrop{background:rgb(0 0 0 / .5)}.ds-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.ds-dialog h2{margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-.025em;overflow-wrap:break-word}.ds-dialog-sub{margin:8px 0 0;font-size:14px;line-height:24px}.ds-close{display:flex;width:44px;height:44px;align-items:center;justify-content:center;border:0;border-radius:3.40282e+38px;background:transparent;color:inherit;touch-action:manipulation}.ds-close:hover{background:rgb(0 0 0 / .05)}.ds-dialog-summary{margin:24px 0 0;font-size:16px;line-height:28px}.ds-dialog-description{margin:16px 0 0;font-size:14px;line-height:28px}@media(min-width:40rem){.ds-dialog{padding:32px}}:host-context(html[data-theme=\"dark\"]) .ds-preview{color:#edeee8}:host-context(html[data-theme=\"dark\"]) .ds-muted{color:#a4a89c}:host-context(html[data-theme=\"dark\"]) .ds-focus:focus-visible{outline-color:#a9bddf}:host-context(html[data-theme=\"dark\"]) .ds-link{color:#9aaed7}:host-context(html[data-theme=\"dark\"]) .ds-link:hover{color:#c5d3ee}:host-context(html[data-theme=\"dark\"]) .ds-dialog{background:#161713}:host-context(html[data-theme=\"dark\"]) .ds-close:hover{background:rgb(255 255 255 / .05)}@media(prefers-color-scheme:dark){:host-context(html:not([data-theme=\"light\"])) .ds-preview{color:#edeee8}:host-context(html:not([data-theme=\"light\"])) .ds-muted{color:#a4a89c}:host-context(html:not([data-theme=\"light\"])) .ds-focus:focus-visible{outline-color:#a9bddf}:host-context(html:not([data-theme=\"light\"])) .ds-link{color:#9aaed7}:host-context(html:not([data-theme=\"light\"])) .ds-link:hover{color:#c5d3ee}:host-context(html:not([data-theme=\"light\"])) .ds-dialog{background:#161713}:host-context(html:not([data-theme=\"light\"])) .ds-close:hover{background:rgb(255 255 255 / .05)}}"
    }
